# Headers for the files Cloudflare serves without the Worker (see run_worker_first in wrangler.app.jsonc).
# Names under /assets/ and /media/ change when their content changes: a year in the browser's cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/media/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/*
  X-Content-Type-Options: nosniff
