// The one Worker: tcf.monster (the public site and the application) and admin.tcf.monster; app.tcf.monster and
// www.tcf.monster answer a redirect to tcf.monster. One D1 database, one R2 bucket.
{
  "name": "tcf-monster-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // the question bank's files (/data) go through the Worker: signed-in people only (worker/coce/guard.ts); its
    // recordings and pictures (/media) are plain files under names only those files carry (scripts/copy-media.mjs)
    "run_worker_first": ["/*", "!/assets/*", "!/media/*", "!/fonts/*", "!/worklets/*", "!/site/assets/*"]
  },
  "routes": [
    { "pattern": "tcf.monster", "custom_domain": true },
    { "pattern": "www.tcf.monster", "custom_domain": true },
    { "pattern": "app.tcf.monster", "custom_domain": true },
    { "pattern": "admin.tcf.monster", "custom_domain": true }
  ],
  "workers_dev": false,
  "d1_databases": [{ "binding": "DB", "database_name": "tcf-monster", "database_id": "7a0d38dc-1b69-4c33-a50b-08b1a102afa5", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tcf-monster-files" }],
  // sign-in requests: 20 a minute per address, counted across all of Cloudflare's servers (free on every plan)
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "8001", "simple": { "limit": 20, "period": 60 } },
    // one signed-in person's requests (worker/guard.ts): past 90 a minute the human check, past 240 after it a block
    { "name": "USER_PACE", "namespace_id": "8005", "simple": { "limit": 90, "period": 60 } },
    { "name": "USER_BURST", "namespace_id": "8006", "simple": { "limit": 240, "period": 60 } }
  ],
  // the Worker itself: the nightly run calls each job through it, each with its own CPU time (worker/index.ts)
  "services": [{ "binding": "SELF", "service": "tcf-monster-app" }],
  // one schedule only: the free plan allows 5 for the whole account, shared with the other apps
  "triggers": { "crons": ["0 22 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "APP_TZ": "Asia/Tashkent",
    "OWNER_EMAIL": "owner@example.com",
    // "0": only a signed-in session of OWNER_EMAIL opens the admin (sign in on tcf.monster)
    "ADMIN_OPEN": "0",
    // "1": anyone may create an account (opened 2026-10-19); "0" would let in only OWNER_EMAIL and TESTERS
    "APP_OPEN": "1",
    "TESTERS": "",
    "MAIL_FROM": "tcf.monster <bonjour@tcf.monster>",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFgYw3EsVNkcVzcd",
    // Cloudflare Access on admin.tcf.monster (Zero Trust › Access › Applications › admin): the admin checks its token
    "ACCESS_TEAM": "yaxshiyashaylik.cloudflareaccess.com",
    "ACCESS_AUD": "259a9cee7e9bbeaac1c3551eef20bc559ed33ad92f1086cc8a51f5f06a7c9683"
  }
}
